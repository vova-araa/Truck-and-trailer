# Kopieer dit bestand naar .env en vul je waarden in.

# --- Supabase (frontend, VITE_ = zichtbaar in de browser) ---
# Vind deze in Supabase -> Project Settings -> API.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- AI-proxy (server-side, NOOIT in de browser) ---
# Alleen de Node-server (server/index.js) leest deze. Zonder key werkt de app
# gewoon; alleen de AI-functies zijn dan uitgeschakeld.
ANTHROPIC_API_KEY=sk-ant-...
# Optioneel: welk model de proxy gebruikt (standaard claude-opus-4-8)
# ANTHROPIC_MODEL=claude-opus-4-8

# Poort voor de server bij lokaal draaien (standaard 8787). Railway zet PORT zelf.
# PORT=8787
